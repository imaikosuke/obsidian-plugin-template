{
	"name": "obsidian-plugin-template",
	"version": "0.0.1",
	"description": "Scaffold for Obsidian plugins. Fork and replace names, then implement your features.",
	"main": "main.js",
	"scripts": {
		"setup": "node onboard.mjs",
		"setup:check": "node onboard.mjs --check",
		"dev": "node esbuild.config.mjs",
		"type": "tsc -noEmit --skipLibCheck",
		"check": "pnpm type && pnpm lint && pnpm build",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"release": "bash release.sh",
		"version": "node version-bump.mjs && git add manifest.json versions.json README.md",
		"lint": "eslint main.ts ./src/",
		"lint:fix": "eslint main.ts ./src/ --fix"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"plugin"
	],
	"author": "imaikosuke",
	"authorUrl": "https://github.com/imaikosuke",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.6.6",
		"@typescript-eslint/eslint-plugin": "^8.72.1",
		"@typescript-eslint/parser": "^8.72.1",
		"esbuild": "0.28.2",
		"eslint": "^10.14.0",
		"eslint-plugin-obsidianmd": "^0.5.1",
		"obsidian": "^1.14.4",
		"tslib": "2.9.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1"
	},
	"packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
